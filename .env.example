BOT_TOKEN=your_bot_token_here

# CONTACT_USERNAME is NOT used in ads anymore.
# Every announcement shows the contact of the person who posted it.
CONTACT_USERNAME=

# Your Telegram numeric user id (from @userinfobot). Free cargo posts + /pending.
ADMIN_ID=your_telegram_id
# Группа «Грузоперевозки». Пустое значение и @tranzitpro1 в коде заменяются на этот id.
CHANNEL_ID=-1001140181745
DATABASE_PATH=bot.db

# Free posters: cargo without payment. Default in code: Oleg34381.
# FREE_POST_USERNAMES overrides the default when set (comma-separated @usernames).
FREE_POST_USERNAMES=Oleg34381
# Optional numeric ids (more reliable if username changes):
# FREE_POST_USER_IDS=123456789

# Manual payment for cargo ads (logisticians). Drivers stay free.
# PAYMENT_ENABLED=0 temporarily disables the paywall.
PAYMENT_ENABLED=1
AD_POST_PRICE=50 000 сум
PAYMENT_DETAILS=Карта: 8600 xxxx xxxx xxxx\nТелефон: +998 xx xxx xx xx\nКомментарий к платежу: «груз»

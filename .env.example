BOT_TOKEN=your_bot_token_here

# CONTACT_USERNAME is NOT used in ads anymore.
# Every announcement shows the contact of the person who posted it.
CONTACT_USERNAME=

# Your Telegram numeric user id (from @userinfobot). Free cargo posts + /pending.
# Admins bypass channel subscription + invite requirements.
ADMIN_ID=your_telegram_id
CHANNEL_ID=-100xxxxxxxxxx
# Public @ of the channel (shown in messages / «Подписаться» button). Optional.
CHANNEL_USERNAME=@tranzitpro1
DATABASE_PATH=bot.db

# To post cargo/vehicle ads a user must: 1) join the channel 2) invite N people.
# Bot must be channel admin with permission to invite users (create invite links).
# POST_REQUIREMENTS_ENABLED=0 temporarily disables this gate (admins always free).
POST_REQUIREMENTS_ENABLED=1
MIN_CHANNEL_INVITES=5

# Manual payment for cargo ads (logisticians). Drivers stay free.
# PAYMENT_ENABLED=0 temporarily disables the paywall.
PAYMENT_ENABLED=1
AD_POST_PRICE=50 000 сум
PAYMENT_DETAILS=Карта: 8600 xxxx xxxx xxxx\nТелефон: +998 xx xxx xx xx\nКомментарий к платежу: «груз»
